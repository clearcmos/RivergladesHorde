package-as: CMOS_Riverglades

required-dependencies:
  - restedxp-guide

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

ignore:
  - README.md
  - CHANGELOG.md
  - CI.md
  - CLAUDE.md
  - SOURCES.md
  - .github
  - .gitignore
  - .pkgmeta
  - .luacheckrc
  - stylua.toml
  - tests
  - tools
  - assets
